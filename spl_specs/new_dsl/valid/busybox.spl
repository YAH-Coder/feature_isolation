SPL BusyBoxEmbeddedProfile

FEATURES 22
  INIT LINUXRC FEATURE_USE_INITTAB FEATURE_INIT_SYSLOG
  SYSLOGD FEATURE_REMOTE_LOG FEATURE_IPC_SYSLOG
  SH_IS_ASH SH_IS_HUSH FEATURE_SH_MATH FEATURE_SH_STANDALONE
  WGET FEATURE_WGET_STATUSBAR FEATURE_WGET_TIMEOUT
  IFCONFIG FEATURE_IFCONFIG_STATUS
  UDHCPC FEATURE_UDHCPC_ARPING
  CROND FEATURE_CROND_SPECIAL_TIMES
  MOUNT FEATURE_MOUNT_LOOP

CONSTRAINTS
  ASSERT FEATURE_USE_INITTAB -> (INIT || LINUXRC)
  ASSERT FEATURE_INIT_SYSLOG -> (INIT || LINUXRC)
  ASSERT FEATURE_REMOTE_LOG -> SYSLOGD
  ASSERT FEATURE_IPC_SYSLOG -> SYSLOGD
  ASSERT FEATURE_SH_MATH -> (SH_IS_ASH || SH_IS_HUSH)
  ASSERT FEATURE_SH_STANDALONE -> (SH_IS_ASH || SH_IS_HUSH)
  ASSERT FEATURE_WGET_STATUSBAR -> WGET
  ASSERT FEATURE_WGET_TIMEOUT -> WGET
  ASSERT FEATURE_IFCONFIG_STATUS -> IFCONFIG
  ASSERT FEATURE_UDHCPC_ARPING -> UDHCPC
  ASSERT FEATURE_CROND_SPECIAL_TIMES -> CROND
  ASSERT FEATURE_MOUNT_LOOP -> MOUNT

  ASSERT COUNT(INIT, LINUXRC) = 1
  ASSERT FEATURE_USE_INITTAB <-> INIT
  ASSERT FEATURE_INIT_SYSLOG <-> SYSLOGD

  ASSERT COUNT(SH_IS_ASH, SH_IS_HUSH) = 1
  ASSERT FEATURE_SH_MATH <-> (SH_IS_ASH || SH_IS_HUSH)
  ASSERT FEATURE_SH_STANDALONE <-> SH_IS_HUSH

  ASSERT COUNT(FEATURE_REMOTE_LOG, FEATURE_IPC_SYSLOG) = 1
  ASSERT SYSLOGD <-> (FEATURE_REMOTE_LOG || FEATURE_IPC_SYSLOG)

  ASSERT WGET <-> IFCONFIG
  ASSERT IFCONFIG <-> UDHCPC
  ASSERT UDHCPC <-> CROND
  ASSERT CROND <-> MOUNT

  ASSERT FEATURE_WGET_STATUSBAR <-> WGET
  ASSERT FEATURE_WGET_TIMEOUT <-> WGET
  ASSERT FEATURE_IFCONFIG_STATUS <-> IFCONFIG
  ASSERT FEATURE_UDHCPC_ARPING <-> UDHCPC
  ASSERT FEATURE_CROND_SPECIAL_TIMES <-> CROND
  ASSERT FEATURE_MOUNT_LOOP <-> MOUNT
END
