# Makefile feature isolation testing

CXX = g++
CXXFLAGS = -std=c++20 -Wall -pedantic 
INCDIR = ../include
SRCDIR = ../src
OBJDIR = ../obj

it: a.out

a.out: $(OBJDIR)/feature_analysis.o $(OBJDIR)/isolation.o
	$(CXX) $(CXXFLAGS) $(OBJDIR)/feature_analysis.o $(OBJDIR)/isolation.o -lz3

$(OBJDIR)/feature_analysis.o: $(SRCDIR)/feature_analysis.cpp $(INCDIR)/feature_analysis.hpp
	$(CXX) $(CXXFLAGS) -c $(SRCDIR)/feature_analysis.cpp -o $(OBJDIR)/feature_analysis.o

$(OBJDIR)/isolation.o: $(SRCDIR)/isolation_test_z3.cpp $(INCDIR)/isolation.hpp $(INCDIR)/spl.hpp
	$(CXX) $(CXXFLAGS) -c $(SRCDIR)/isolation_test_z3.cpp -o $(OBJDIR)/isolation.o

clean:
	rm -f $(OBJDIR)/* a.out
