/**
 * @fn const spl_specification_t& feature_isolation::spl_processor_t::get_specification() const
 * @brief Retrieves the parsed SPL specification.
 *
 * @return A constant reference to the `spl_specification_t` object.
 */

/**
 * @fn std::string feature_isolation::toupper(std::string s)
 * @brief Converts a string to uppercase.
 *
 * @param s The string to convert.
 * @return The uppercase version of the string.
 *
 * The function uses `std::transform` and `::toupper` to convert each character.
 */

/**
 * @fn template <typename... Args> void feature_isolation::error(const std::string_view& msg, Args&&... args)
 * @brief Throws a `std::runtime_error` with a formatted message.
 *
 * @tparam Args Variadic template parameters for formatting.
 * @param msg The error message template.
 * @param args Arguments to format into the message.
 *
 * @throws std::runtime_error Always throws with the formatted message.
 *
 * The function uses the `fmt` library to format the message.
 */

/**
 * @typedef feature_isolation::position_t
 * @brief Represents a position in the input stream (line and column).
 *
 * Defined as `std::pair<std::size_t, std::size_t>`.
 */

/**
 * @fn z3::expr feature_isolation::exactly(unsigned n, const z3::expr_vector& xs)
 * @brief Constructs a Z3 expression that is true when exactly `n` of the expressions in `xs` are true.
 *
 * @param n The exact number of expressions that should be true.
 * @param xs A vector of Z3 boolean expressions.
 * @return A Z3 expression representing the constraint.
 *
 * The function sums the expressions and checks if the sum equals `n`.
 */

/**
 * @var feature_isolation::category_map
 * @brief Maps category names to their corresponding bitmask values.
 *
 * Used to determine which feature categories are included in the analysis.
 */

/**
 * @section usage_sec Usage
 *
 * To use the SPL specification parser:
 *
 * 1. **Include the header:**
 *    ```cpp
 *    #include "spl.hpp"
 *    ```
 *
 * 2. **Create an instance of `spl_processor_t`:**
 *    ```cpp
 *    feature_isolation::spl_processor_t processor("spl_specification.csv");
 *    ```
 *
 * 3. **Process the SPL specification:**
 *    ```cpp
 *    auto spec = processor.get_specification();
 *    ```
 *
 * 4. **Access SPL specification details:**
 *    ```cpp
 *    std::cout << "SPL Name: " << spec.m_spl_name << std::endl;
 *    ```
 *
 * 5. **Print the SPL specification to a file:**
 *    ```cpp
 *    processor.print("output_specification.csv");
 *    ```
 *
 * **Note:** Ensure that the CSV files are correctly formatted according to the SPL specification language.
 *
 * @section example_sec Example
 *
 * ```cpp
 * #include "spl.hpp"
 * #include <iostream>
 *
 * int main() {
 *     try {
 *         feature_isolation::spl_processor_t processor("spl_specification.csv");
 *         auto spec = processor.get_specification();
 *
 *         // Access SPL details
 *         std::cout << "SPL Name: " << spec.m_spl_name << std::endl;
 *
 *         // Print the specification to an output file
 *         processor.print("output_specification.csv");
 *     } catch (const std::exception& e) {
 *         std::cerr << "Error: " << e.what() << std::endl;
 *     }
 *     return 0;
 * }
 * ```
 *
 * @section notes_sec Additional Notes
 *
 * - The parser uses the `fmt` library for string formatting and error messages.
 * - Error handling is performed by throwing exceptions with detailed messages.
 * - The Z3 SMT solver is used to validate feature dependencies and system constraints.
 * - The SPL specification language allows for flexible definitions of features and their relationships.
 */

