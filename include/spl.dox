/**
 * @file spl.hpp
 * @brief Provides classes and functions for parsing and processing SPL specifications, and outputting results to CSV files.
 *
 * @page spl_parser SPL Parser and Processor
 *
 * @tableofcontents
 *
 * @section introduction Introduction
 *
 * The `spl.hpp` library offers tools for parsing, processing, and validating Software Product Line (SPL) specifications. It includes classes for tokenizing input files, parsing the SPL syntax, representing the SPL specification, and validating systems against specified constraints using the Z3 SMT solver. The library also supports outputting the parsed and processed SPL data to CSV files for further analysis or reporting.
 *
 * @section components Key Components
 *
 * - **Namespace `feature_isolation`:** Contains all classes and functions related to SPL processing.
 * - **Class `feature_isolation::spl_specification_t`:** Represents an SPL specification, including features, dependencies, and systems.
 * - **Class `feature_isolation::tokenizer_t`:** Tokenizes the input stream according to the SPL syntax.
 * - **Class `feature_isolation::parser_t`:** Parses tokens into an `spl_specification_t` object.
 * - **Class `feature_isolation::printer_t`:** Outputs the SPL specification and analysis results to CSV files.
 * - **Class `feature_isolation::spl_processor_t`:** High-level interface for processing SPL specifications from files and handling CSV output.
 * - **Helper Functions:**
 *   - `feature_isolation::error`: Throws formatted exceptions.
 *   - `feature_isolation::toupper`: Converts strings to uppercase.
 *   - `feature_isolation::exactly`: Z3 helper function for specifying exact cardinality constraints.
 *
 * @section usage Usage
 *
 * 1. Include the header:
 *    ```cpp
 *    #include "spl.hpp"
 *    ```
 * 2. Process an SPL file and output to CSV:
 *    ```cpp
 *    feature_isolation::spl_processor_t processor("path/to/spl_file.csv");
 *    auto spec = processor.get_specification();
 *    processor.print("output.csv");
 *    ```
 * 3. Customizing Output:
 *    You can set the CSV separator character by modifying `csv_separator`.
 *    ```cpp
 *    feature_isolation::csv_separator = ',';
 *    ```
 *
 * @section example Example
 *
 * ```cpp
 * #include <iostream>
 * #include "spl.hpp"
 *
 * int main() {
 *   using namespace feature_isolation;
 *
 *   try {
 *     spl_processor_t processor("example.csv");
 *     processor.print("output.csv");
 *     std::cout << "SPL specification processed and output to CSV." << std::endl;
 *   } catch (const std::exception& e) {
 *     std::cerr << "Error: " << e.what() << std::endl;
 *   }
 *   return 0;
 * }
 * ```
 *
 * **Customization:**
 * - Modify the SPL file to include desired features, dependencies, and systems.
 * - Change the CSV separator character if needed.
 * - Extend the `spl_specification_t` class to include additional validation or processing logic.
 */

/**
 * @namespace feature_isolation
 * @brief Contains all classes and functions related to SPL specification parsing and processing.
 *
 * This namespace provides facilities for:
 * - Tokenizing and parsing SPL specification files.
 * - Validating the consistency and correctness of SPL definitions.
 * - Representing SPL specifications in an object-oriented manner.
 */

/**
 * @var feature_isolation::csv_separator
 * @brief The separator character used for CSV files.
 *
 * Defaults to tab (`'\t'`). Can be set to any character to customize CSV parsing and printing.
 */

/**
 * @namespace feature_isolation::kw
 * @brief Contains all the keywords as `constexpr std::string_view`.
 */

/**
 * @var feature_isolation::kw::keywords
 * @brief Contains a mapping of all keywords and their corresponding `feature_isolation::token_type_t`.
 */

/**
 * @namespace feature_isolation::error_msgs
 * @brief Contains constant error message templates used throughout the SPL parsing and processing.
 */

/**
 * @class feature_isolation::spl_specification_t
 * @brief Represents an SPL specification, including features, dependencies, and systems.
 *
 * @details
 * Stores all the data parsed from an SPL specification CSV file, such as feature names,
 * categories, dependencies between features, and available or missing systems.
 *
 * **Constructor:**
 * ```cpp
 * spl_specification_t(
 *     const std::string& filename,
 *     const std::optional<std::string>& spl_name,
 *     std::optional<unsigned_integer> max_rank,
 *     unsigned_integer F,
 *     unsigned_integer max_available_systems,
 *     const feature_names_t& feature_names,
 *     const dependencies_t& requires_all,
 *     const dependencies_t& requires_any,
 *     const dependencies_t& requires_one,
 *     const dependencies_t& excludes_all,
 *     const systems_t& available_systems,
 *     const systems_t& missing_systems,
 *     bool spl_specified,
 *     bool feature_names_specified,
 *     bool categories_specified,
 *     bool explicit_dependencies_specified,
 *     bool missing_systems_specified,
 *     bool available_systems_specified,
 *     bool max_rank_specified,
 *     unsigned_integer categories = feature_isolation::F);
 * ```
 *
 * **Member Variables:**
 * - `m_filename`: The filename of the SPL specification CSV file.
 * - `m_spl_name`: The name of the SPL.
 * - `m_max_rank`: The maximum rank for feature combinations.
 * - `m_F`: The number of fundamental features.
 * - `m_max_available_systems`: The maximum number of available systems.
 * - `m_feature_names`: The names of the features.
 * - `m_categories`: The categories of features included.
 * - `m_requires_all`, `m_requires_any`, `m_requires_one`, `m_excludes_all`: Dependency maps representing different types of dependencies between features.
 * - `m_available_systems`, `m_missing_systems`: Vectors of system IDs that are available or missing.
 * - Boolean flags indicating whether certain parts of the specification were specified.
 */

/**
 * @fn bool feature_isolation::spl_specification_t::validate_systems() const
 * @brief Validates the systems against the specified dependencies using a Z3 solver.
 *
 * @return `true` if all systems are valid according to the dependencies; otherwise, it throws an error.
 *
 * The function iterates over all available systems and checks whether each system satisfies
 * all the specified constraints (`REQUIRES_ALL`, `REQUIRES_ANY`, `REQUIRES_ONE`, `EXCLUDES_ALL`).
 * It uses the Z3 SMT solver to perform the validation.
 */

/**
 * @fn bool feature_isolation::spl_specification_t::check_constraints(
 *     const std::string& constraint_type,
 *     const dependencies_t& constraints_map,
 *     unsigned_integer system_id,
 *     unsigned_integer system,
 *     z3::context& ctx) const
 * @brief Checks if a system satisfies the specified constraints.
 *
 * @param constraint_type The type of constraint to check (e.g., `REQUIRES_ALL`).
 * @param constraints_map The map of dependencies for the constraint type.
 * @param system_id The ID of the system being checked.
 * @param system The system configuration represented as an unsigned integer.
 * @param ctx The Z3 context used for SMT solving.
 * @return `true` if the system satisfies the constraints; otherwise, it throws an error.
 *
 * This function constructs Z3 expressions representing the constraints and uses a solver to
 * determine if the system configuration satisfies them. If a constraint is violated, it throws
 * an error with a detailed message.
 */

/**
 * @class feature_isolation::token_t
 * @brief Represents a token extracted from the SPL specification file.
 *
 * **Constructor:**
 * ```cpp
 * token_t(
 *     const token_type_t& tt = token_type_t::EMPTY,
 *     const std::string& v = "",
 *     const position_t& b = { 0, 0 },
 *     const position_t& e = { 0, 0 });
 * ```
 *
 * **Member Variables:**
 * - `m_token_type`: The type of token (e.g., `KEYWORD`, `VALUE`, `NAME`).
 * - `m_value`: The textual value of the token.
 * - `m_begin`, `m_end`: Positions (line and column) where the token begins and ends.
 */

/**
 * @fn [[nodiscard]] const token_type_t& feature_isolation::token_t::type() const
 * @brief Retrieves the type of the token.
 *
 * @return A reference to the token's type.
 */

/**
 * @fn [[nodiscard]] const std::string& feature_isolation::token_t::value() const
 * @brief Retrieves the value of the token.
 *
 * @return A reference to the token's value.
 *
 * @throws std::runtime_error If the token type is `EMPTY`.
 */

/**
 * @fn [[nodiscard]] const position_t& feature_isolation::token_t::begin() const
 * @brief Retrieves the beginning position of the token.
 *
 * @return A reference to the token's starting position.
 *
 * @throws std::runtime_error If the token type is `EMPTY`.
 */

/**
 * @fn [[nodiscard]] const position_t& feature_isolation::token_t::end() const
 * @brief Retrieves the ending position of the token.
 *
 * @return A reference to the token's ending position.
 *
 * @throws std::runtime_error If the token type is `EMPTY`.
 */

/**
 * @fn [[nodiscard]] const std::string feature_isolation::token_t::position_line() const
 * @brief Retrieves the line number where the token begins as a string.
 *
 * @return A string representing the line number.
 */

/**
 * @fn [[nodiscard]] const std::string feature_isolation::token_t::position_column() const
 * @brief Retrieves the column number where the token begins as a string.
 *
 * @return A string representing the column number.
 */

/**
 * @enum feature_isolation::token_type_t
 * @brief Enumerates the types of tokens recognized during tokenization.
 *
 * **Values:**
 * - `EMPTY`: Represents no token.
 * - `UNKNOWN`: Token type is unknown.
 * - `COMMENT`: A comment token.
 * - `KEYWORD`: A keyword token.
 * - `VALUE`: A numeric value token.
 * - `NAME`: A name token (identifiers for features, etc.).
 */

/**
 * @class feature_isolation::tokenizer_t
 * @brief Tokenizes the input stream into tokens for parsing.
 *
 * **Constructor:**
 * ```cpp
 * tokenizer_t(std::istream& is);
 * ```
 *
 * **Member Variables:**
 * - `std::istream& m_is;`
 *   - Reference to the input stream being tokenized.
 * - `position_t m_position;`
 *   - The current position in the input stream (line and column).
 */

/**
 * @fn token_t feature_isolation::tokenizer_t::next()
 * @brief Retrieves the next token from the input stream.
 *
 * @return The next `token_t` object.
 *
 * The `next()` function reads from the input stream and returns the next token. It handles:
 * - Skipping whitespace characters.
 * - Recognizing and skipping comments starting with `//`.
 * - Parsing valid tokens (identifiers, keywords, values).
 * - Ignoring unrecognized characters.
 *
 * The function uses helper methods to modularize the tokenization process.
 */

/**
 * @fn [[nodiscard]] std::optional<token_t> feature_isolation::tokenizer_t::check_keyword(const std::string& token)
 * @brief Checks if a string is a recognized keyword and returns the corresponding token.
 *
 * @param token The string to check.
 * @return An optional `token_t` if the token is a keyword; otherwise, `std::nullopt`.
 *
 * This function converts the input string to uppercase and looks it up in the `keywords` map.
 * If found, it returns a `token_t` with the appropriate token type.
 */

/**
 * @fn bool feature_isolation::tokenizer_t::is_token_char(char c) const
 * @brief Checks if a character is valid within a token.
 *
 * @param c The character to check.
 * @return `true` if the character is valid in a token; otherwise, `false`.
 *
 * Valid token characters include alphanumeric characters, underscore (`_`), hash (`#`), hyphen (`-`), and period (`.`).
 */

/**
 * @fn bool feature_isolation::tokenizer_t::is_whitespace(char c) const
 * @brief Checks if a character is a whitespace character.
 *
 * @param c The character to check.
 * @return `true` if the character is whitespace; otherwise, `false`.
 */

/**
 * @fn void feature_isolation::tokenizer_t::consume_char(char& c)
 * @brief Consumes a character from the input stream and updates the current position.
 *
 * @param c The character variable to store the consumed character.
 *
 * If the consumed character is a newline (`'\n'`), the line number is incremented, and the column number is reset to 1. Otherwise, the column number is incremented.
 */

/**
 * @fn void feature_isolation::tokenizer_t::skip_line()
 * @brief Skips the rest of the current line, typically used to ignore comments.
 *
 * Consumes characters until a newline character is encountered, updating the position accordingly.
 */

/**
 * @fn token_t feature_isolation::tokenizer_t::parse_token()
 * @brief Parses a sequence of characters that form a token.
 *
 * @return A `token_t` object representing the parsed token.
 *
 * The function reads characters from the input stream that are valid token characters (as determined by `is_token_char`). It constructs the token string and determines its type:
 * - If the token consists entirely of digits, it is a `VALUE` token.
 * - If the token matches a keyword (checked via `check_keyword`), it is assigned the corresponding token type.
 * - Otherwise, it is considered a `NAME` token.
 *
 * The function also records the starting and ending positions of the token for error reporting.
 */

/**
 * @class feature_isolation::parser_t
 * @brief Parses tokens to build an SPL specification object.
 *
 * **Constructor:**
 * ```cpp
 * parser_t(std::istream& is, std::string filename);
 * ```
 *
 * **Member Variables:**
 * - `tokenizer_t m_tokenizer;`
 *   - The tokenizer used to extract tokens from the input stream.
 * - `spl_specification_t m_spec;`
 *   - The SPL specification object constructed during parsing.
 */

/**
 * @fn spl_specification_t feature_isolation::parser_t::parse_specification(const std::string& filename)
 * @brief Parses the entire SPL specification from the input stream.
 *
 * @param filename The name of the SPL specification file.
 * @return The constructed `spl_specification_t` object.
 *
 * The function reads tokens using the tokenizer and constructs the SPL specification by parsing different sections such as `SPL`, `FEATURES`, `CATEGORIES`, `EXPLICIT_DEPENDENCIES`, and systems definitions. It handles errors and ensures that the specification is correctly built.
 */

/**
 * @fn std::optional<std::string> feature_isolation::parser_t::parse_spl()
 * @brief Parses the `SPL` section to extract the SPL name.
 *
 * @return The SPL name if specified; otherwise, `std::nullopt`.
 *
 * This function expects the next token to be the SPL name and returns it.
 */

/**
 * @fn std::optional<unsigned_integer> feature_isolation::parser_t::parse_max_rank()
 * @brief Parses the `MAX_RANK` section to extract the maximum rank.
 *
 * @return The maximum rank if specified; otherwise, `std::nullopt`.
 *
 * The function reads the next token and attempts to convert it to an unsigned integer.
 */

/**
 * @fn std::pair<unsigned_integer, feature_names_t> feature_isolation::parser_t::parse_features()
 * @brief Parses the `FEATURES` section to extract the number of features and their names.
 *
 * @return A pair containing the number of features and a vector of feature names.
 *
 * The function reads the feature count and then reads each feature name, storing them in a vector.
 */

/**
 * @fn unsigned_integer feature_isolation::parser_t::parse_categories()
 * @brief Parses the `CATEGORIES` section to determine which feature categories are included.
 *
 * @return An unsigned integer representing the bitmask of included categories.
 *
 * The function reads category names until it encounters the `END` keyword, updating a bitmask to represent the included categories.
 */

/**
 * @struct feature_isolation::parser_t::dependency_maps_t
 * @brief Holds the dependency maps parsed from the `EXPLICIT_DEPENDENCIES` section.
 *
 * **Member Variables:**
 * - `dependencies_t requires_all;`
 * - `dependencies_t requires_any;`
 * - `dependencies_t requires_one;`
 * - `dependencies_t excludes_all;`
 */

/**
 * @fn dependency_maps_t feature_isolation::parser_t::parse_explicit_dependencies(const feature_names_t& feature_names)
 * @brief Parses the `EXPLICIT_DEPENDENCIES` section to extract dependencies between features.
 *
 * @param feature_names The vector of feature names for reference.
 * @return A `dependency_maps_t` struct containing the dependency maps.
 *
 * The function reads dependencies specified under different constraint types (`REQUIRES_ALL`, `EXCLUDES_ALL`, etc.) and constructs maps representing these dependencies.
 */

/**
 * @fn spl_specification_t::systems_t feature_isolation::parser_t::parse_available_systems()
 * @brief Parses the `AVAILABLE_SYSTEMS` section to extract the list of available system IDs.
 *
 * @return A vector of available system IDs.
 *
 * The function reads system IDs until the end of the section.
 */

/**
 * @fn spl_specification_t::systems_t feature_isolation::parser_t::parse_missing_systems()
 * @brief Parses the `MISSING_SYSTEMS` section to extract the list of missing system IDs.
 *
 * @return A vector of missing system IDs.
 *
 * Similar to `parse_available_systems()`, but for missing systems.
 */

/**
 * @fn std::optional<signed int> feature_isolation::parser_t::feature_index(const std::string& feature, const feature_names_t& feature_names) const
 * @brief Finds the index of a feature in the feature names vector.
 *
 * @param feature The feature name to look up.
 * @param feature_names The vector of feature names.
 * @return The index of the feature if found; otherwise, throws an error.
 *
 * If the feature name is `ROOT`, it returns `-1`. Otherwise, it searches for the feature name in the vector and returns its index.
 */

/**
 * @fn spl_specification_t::systems_t feature_isolation::parser_t::effective_available_systems(
 *     unsigned_integer max_available_systems,
 *     const spl_specification_t::systems_t& available_systems,
 *     const spl_specification_t::systems_t& missing_systems,
 *     bool available_systems_specified,
 *     bool missing_systems_specified) const
 * @brief Computes the effective list of available systems based on specified and missing systems.
 *
 * @param max_available_systems The maximum number of systems.
 * @param available_systems The specified available systems.
 * @param missing_systems The specified missing systems.
 * @param available_systems_specified Whether available systems were specified.
 * @param missing_systems_specified Whether missing systems were specified.
 * @return A vector of effective available system IDs.
 *
 * The function determines the actual list of available systems by considering both specified available and missing systems.
 */

/**
 * @class feature_isolation::printer_t
 * @brief Outputs the SPL specification in a structured format.
 *
 * **Constructor:**
 * ```cpp
 * printer_t(std::ostream& os);
 * ```
 *
 * **Member Variables:**
 * - `std::ostream& m_os;`
 *   - Reference to the output stream where the specification will be printed.
 */

/**
 * @fn void feature_isolation::printer_t::print_specification(const spl_specification_t& spec)
 * @brief Prints the entire SPL specification to the output stream.
 *
 * @param spec The SPL specification to print.
 *
 * The function calls individual print methods for different sections of the specification.
 */

/**
 * @fn void feature_isolation::printer_t::print_spl_name(const spl_specification_t& spec)
 * @brief Prints the `SPL` section if specified.
 *
 * @param spec The SPL specification containing the SPL name.
 */

/**
 * @fn void feature_isolation::printer_t::print_max_rank(const spl_specification_t& spec)
 * @brief Prints the `MAX_RANK` section if specified.
 *
 * @param spec The SPL specification containing the maximum rank.
 */

/**
 * @fn void feature_isolation::printer_t::print_features(const spl_specification_t& spec)
 * @brief Prints the `FEATURES` section.
 *
 * @param spec The SPL specification containing the feature names.
 */

/**
 * @fn void feature_isolation::printer_t::print_categories(const spl_specification_t& spec)
 * @brief Prints the `CATEGORIES` section if specified.
 *
 * @param spec The SPL specification containing the categories.
 */

/**
 * @fn void feature_isolation::printer_t::print_dependencies(const spl_specification_t& spec)
 * @brief Prints the `EXPLICIT_DEPENDENCIES` section if specified.
 *
 * @param spec The SPL specification containing the dependencies.
 *
 * The function iterates over each dependency map and prints the dependencies under their respective types.
 */

/**
 * @fn void feature_isolation::printer_t::print_systems(const spl_specification_t& spec)
 * @brief Prints the `AVAILABLE_SYSTEMS` or `MISSING_SYSTEMS` section if specified.
 *
 * @param spec The SPL specification containing the system IDs.
 */

/**
 * @class feature_isolation::spl_processor_t
 * @brief High-level class that processes an SPL specification file.
