 */

/**
 * @fn void feature_isolation::debug_token(const token_t& token)
 * @brief Outputs debug information about a token.
 *
 * @param token The token to debug.
 */

/**
 * @fn bool feature_isolation::feature_present(const std::vector<bool>& anf_feature, const std::vector<bool>& f_feature, unsigned_integer F)
 * @brief Determines if a feature is present in more than half of the systems.
 *
 * @param anf_feature The feature vector to check.
 * @param f_feature The fundamental feature vector.
 * @param F The number of fundamental features.
 * @return `true` if the feature is present in more than half of the systems; otherwise, `false`.
 */

/**
 * @fn bool feature_isolation::feature_and(const std::vector<bool>& and_feature, const std::vector<bool>& f_feature)
 * @brief Checks if the `and_feature` is logically included in the `f_feature`.
 *
 * @param and_feature The AND feature vector.
 * @param f_feature The fundamental feature vector.
 * @return `true` if `and_feature` is included in `f_feature`; otherwise, `false`.
 */

/**
 * @fn bool feature_isolation::feature_or(const std::vector<bool>& or_feature, const std::vector<bool>& f_feature)
 * @brief Checks if the `f_feature` is logically included in the `or_feature`.
 *
 * @param or_feature The OR feature vector.
 * @param f_feature The fundamental feature vector.
 * @return `true` if `f_feature` is included in `or_feature`; otherwise, `false`.
 */

/**
 * @fn bool feature_isolation::feature_and_not(const std::vector<bool>& and_not_feature, const std::vector<bool>& f_feature)
 * @brief Checks if the `and_not_feature` excludes the `f_feature`.
 *
 * @param and_not_feature The AND NOT feature vector.
 * @param f_feature The fundamental feature vector.
 * @return `true` if `and_not_feature` excludes `f_feature`; otherwise, `false`.
 */

/**
 * @fn bool feature_isolation::feature_or_not(const std::vector<bool>& or_not_feature, const std::vector<bool>& f_feature)
 * @brief Checks if the negation of `f_feature` is logically included in the `or_not_feature`.
 *
 * @param or_not_feature The OR NOT feature vector.
 * @param f_feature The fundamental feature vector.
 * @return `true` if the negation of `f_feature` is included in `or_not_feature`; otherwise, `false`.
 */

/**
 * @fn std::vector<bool> feature_isolation::operator|(std::vector<bool> v1, const std::vector<bool>& v2)
 * @brief Performs element-wise logical OR between two vectors of bools.
 *
 * @param v1 The first vector.
 * @param v2 The second vector.
 * @return A new vector resulting from the logical OR of `v1` and `v2`.
 *
 * @throws std::range_error If the vectors have different sizes.
 */

/**
 * @fn std::vector<bool> feature_isolation::operator&(std::vector<bool> v1, const std::vector<bool>& v2)
 * @brief Performs element-wise logical AND between two vectors of bools.
 *
 * @param v1 The first vector.
 * @param v2 The second vector.
 * @return A new vector resulting from the logical AND of `v1` and `v2`.
 *
 * @throws std::range_error If the vectors have different sizes.
 */

/**
 * @fn std::vector<bool> feature_isolation::operator~(std::vector<bool> v)
 * @brief Performs element-wise logical NOT on a vector of bools.
 *
 * @param v The vector to negate.
 * @return A new vector resulting from the logical NOT of `v`.
 */

/**
 * @fn bool feature_isolation::operator==(const std::vector<bool>& v1, const std::vector<bool>& v2)
 * @brief Checks if two vectors of bools are equal.
 *
 * @param v1 The first vector.
 * @param v2 The second vector.
 * @return `true` if the vectors are equal; otherwise, `false`.
 */

/**
 * @fn unsigned_integer feature_isolation::dot_product(const std::vector<bool>& v)
 * @brief Counts the number of `true` values in the vector.
 *
 * @param v The vector to count.
 * @return The number of `true` values in the vector.
 */

/**
 * @fn bool feature_isolation::feature_bool_and(const std::vector<bool>& f1, const std::vector<bool>& f2)
 * @brief Checks if there is any position where both `f1` and `f2` are `true`.
 *
 * @param f1 The first feature vector.
 * @param f2 The second feature vector.
 * @return `true` if there is at least one position where both are `true`; otherwise, `false`.
 */

/**
 * @fn std::string feature_isolation::name(unsigned_integer fid) const
 * @brief Generates a human-readable name for a feature based on its components.
 *
 * @param fid The feature ID.
 * @return A string representing the name of the feature.
 */

/**
 * @section usage_sec Usage
 *
 * To use the SPL specification parser:
 *
 * 1. **Include the header:**
 *    ```cpp
 *    #include "spl.hpp"
 *    ```
 *
 * 2. **Create an instance of `spl_processor_t`:**
 *    ```cpp
 *    feature_isolation::spl_processor_t processor("spl_specification.csv");
 *    ```
 *
 * 3. **Process the SPL specification:**
 *    ```cpp
 *    auto spec = processor.get_specification();
 *    ```
 *
 * 4. **Access SPL specification details:**
 *    ```cpp
 *    std::cout << "SPL Name: " << spec.m_spl_name << std::endl;
 *    ```
 *
 * 5. **Print the SPL specification to a file:**
 *    ```cpp
 *    processor.print("output_specification.csv");
 *    ```
 *
 * **Note:** Ensure that the CSV files are correctly formatted according to the SPL specification language.
 *
 * @section example_sec Example
 *
 * ```cpp
 * #include "spl.hpp"
 * #include <iostream>
 *
 * int main() {
 *     try {
 *         feature_isolation::spl_processor_t processor("spl_specification.csv");
 *         auto spec = processor.get_specification();
 *
 *         // Access SPL details
 *         std::cout << "SPL Name: " << spec.m_spl_name << std::endl;
 *
 *         // Print the specification to an output file
 *         processor.print("output_specification.csv");
 *     } catch (const std::exception& e) {
 *         std::cerr << "Error: " << e.what() << std::endl;
 *     }
 *     return 0;
 * }
 * ```
 *
 * @section notes_sec Additional Notes
 *
 * - The parser uses the `fmt` library for string formatting and error messages.
 * - Error handling is performed by throwing exceptions with detailed messages.
 * - The Z3 SMT solver is used to validate feature dependencies and system constraints.
 * - The SPL specification language allows for flexible definitions of features and their relationships.
 */

