 * @var std::vector<features_t*> feature_isolation::feature_analysis_t::m_all_features
 * @brief Pointers to all feature vectors.
 *
 * @details
 * Allows for unified access to all feature categories.
 */

/**
 * @var systems_t feature_isolation::feature_analysis_t::m_systems
